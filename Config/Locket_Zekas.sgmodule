#!url=https://raw.githubusercontent.com/lhhoang5425/nocket-gay-hoang3te/main/Config/Locket_Zekas.sgmodule
#!name=Locket-Zekas_Gold
#!desc=Crack Full By Zekas Dev (iOS 15-18 Compatible)

[Rule]
# Chặn QUIC/HTTP3 qua UDP (Port 443) ép iOS 17 dùng TCP HTTPS để giải mã MITM
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT

# Chặn Apple Private Relay tránh rò rỉ và bypass tunnel ngầm trên iOS 17
DOMAIN-SUFFIX,apple-relay.apple.com,REJECT
DOMAIN-SUFFIX,apple-relay.cloudflare.com,REJECT
DOMAIN-SUFFIX,apple-relay.akamaized.net,REJECT
DOMAIN-SUFFIX,apple-relay.fastly-edge.com,REJECT
DOMAIN-SUFFIX,apple-relay.mask.apple-dns.net,REJECT
DOMAIN-SUFFIX,mask.icloud.com,REJECT
DOMAIN-SUFFIX,mask-h2.icloud.com,REJECT
DOMAIN-SUFFIX,mask-api.icloud.com,REJECT

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/lhhoang5425/nocket-gay-hoang3te/main/js/Locket/Locket_Zekas.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/lhhoang5425/nocket-gay-hoang3te/main/js/Locket/deleteHeader.js, timeout=60

locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/lhhoang5425/nocket-gay-hoang3te/main/js/Locket/Locket_Unlocked.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
